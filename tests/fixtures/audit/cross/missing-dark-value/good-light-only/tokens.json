{
  "$description": "fixture: missing-dark-value/good-light-only",
  "$extensions": {
    "plumb": {
      "schema": 1,
      "project": "demo",
      "platforms": [
        "web"
      ],
      "web": {
        "styling": "tailwind-v4",
        "copies": []
      }
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": "#ffffff"
    },
    "surface": {
      "$value": "#f6f7f9"
    },
    "on-surface": {
      "$value": "#1b2230"
    },
    "text-muted": {
      "$value": "#4b5563"
    },
    "primary": {
      "$value": "#0f6e69"
    },
    "on-primary": {
      "$value": "#ffffff"
    },
    "link": {
      "$value": "{color.primary}"
    }
  },
  "typography": {
    "$type": "typography",
    "xs": {
      "$value": {
        "fontSize": "12px",
        "lineHeight": "16px"
      }
    },
    "sm": {
      "$value": {
        "fontSize": "14px",
        "lineHeight": "20px"
      }
    },
    "base": {
      "$value": {
        "fontSize": "16px",
        "lineHeight": "24px"
      }
    },
    "lg": {
      "$value": {
        "fontSize": "20px",
        "lineHeight": "28px"
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": {
      "$value": "4px"
    },
    "md": {
      "$value": "8px"
    }
  },
  "spacing": {
    "$type": "dimension",
    "1": {
      "$value": "4px"
    },
    "2": {
      "$value": "8px"
    },
    "3": {
      "$value": "12px"
    },
    "4": {
      "$value": "16px"
    },
    "6": {
      "$value": "24px"
    },
    "11": {
      "$value": "44px"
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": "150ms"
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "out": {
        "$value": [
          0.2,
          0.8,
          0.2,
          1
        ]
      }
    }
  }
}
