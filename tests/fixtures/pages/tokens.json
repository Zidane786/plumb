{
  "$description": "Pages fixture: every token group, light and dark, a non-ASCII project name",
  "$extensions": {
    "plumb": {
      "schema": 1,
      "project": "Café Ünïcode",
      "platforms": ["web"],
      "docs_dir": "docs/design",
      "web": { "styling": "tailwind-v4", "copies": [] }
    }
  },
  "color": {
    "$type": "color",
    "background": { "$value": "#ffffff", "$description": "Page ground <b>&amp; body</b>", "$extensions": { "plumb": { "dark": "#0f1217" } } },
    "surface": { "$value": "#f6f7f9", "$extensions": { "plumb": { "dark": "#171b22" } } },
    "sunk": { "$value": "#eceff3", "$extensions": { "plumb": { "dark": "#0b0e12" } } },
    "on-surface": { "$value": "#1b2230", "$extensions": { "plumb": { "dark": "#e7eaef" } } },
    "text-muted": { "$value": "#4b5563", "$extensions": { "plumb": { "dark": "#a3acb9" } } },
    "outline": { "$value": "#c9ced6", "$extensions": { "plumb": { "dark": "#323a46" } } },
    "outline-input": { "$value": "#6b7380", "$extensions": { "plumb": { "dark": "#8a93a1" } } },
    "primary": { "$value": "#0f6e69", "$description": "Accent: focus ring, active, primary", "$extensions": { "plumb": { "dark": "#4fb3c4" } } },
    "on-primary": { "$value": "#ffffff", "$extensions": { "plumb": { "dark": "#0f1217" } } },
    "danger": { "$value": "#b42318", "$extensions": { "plumb": { "dark": "#f97066" } } },
    "on-danger": { "$value": "#ffffff", "$extensions": { "plumb": { "dark": "#0f1217" } } },
    "warning": { "$value": "#8a5a00", "$extensions": { "plumb": { "dark": "#fdb022" } } },
    "success": { "$value": "#067647", "$extensions": { "plumb": { "dark": "#47cd89" } } },
    "link": { "$value": "{color.primary}" },
    "scrim": { "$value": "#0f1217cc", "$extensions": { "plumb": { "dark": "#000000cc" } } }
  },
  "label": {
    "$type": "color",
    "teal": { "$value": "#0e7490", "$extensions": { "plumb": { "dark": "#67e8f9" } } }
  },
  "font": {
    "$type": "fontFamily",
    "sans": { "$value": ["system-ui", "Segoe UI", "sans-serif"] },
    "mono": { "$value": ["ui-monospace", "Menlo", "monospace"] }
  },
  "typography": {
    "$type": "typography",
    "xs": { "$value": { "fontSize": "12px", "lineHeight": "16px" } },
    "sm": { "$value": { "fontSize": "14px", "lineHeight": "20px" } },
    "base": {
      "$value": { "fontSize": "16px", "lineHeight": "24px", "fontWeight": 400 },
      "$extensions": { "plumb": { "md": { "fontSize": "15px", "lineHeight": "22px" } } }
    },
    "lg": { "$value": { "fontSize": "20px", "lineHeight": "28px", "fontWeight": 600 } },
    "display": { "$value": { "fontSize": "32px", "lineHeight": "40px", "fontWeight": 700, "letterSpacing": "-0.01em" } }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "4px" },
    "md": { "$value": "8px" },
    "full": { "$value": "9999px" }
  },
  "spacing": {
    "$type": "dimension",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "6": { "$value": "24px" },
    "11": { "$value": "44px" }
  },
  "size": {
    "$type": "dimension",
    "control": { "$value": "40px" }
  },
  "border": {
    "$type": "dimension",
    "thin": { "$value": "1px" }
  },
  "shadow": {
    "$type": "shadow",
    "sm": {
      "$value": [{ "offsetX": "0px", "offsetY": "1px", "blur": "3px", "spread": "0px", "color": "#0f121714" }],
      "$extensions": { "plumb": { "dark": [{ "offsetX": "0px", "offsetY": "1px", "blur": "3px", "spread": "0px", "color": "#00000066" }] } }
    },
    "lg": {
      "$value": [{ "offsetX": "0px", "offsetY": "8px", "blur": "24px", "spread": "-4px", "color": "#0f12171f" }],
      "$extensions": { "plumb": { "dark": [{ "offsetX": "0px", "offsetY": "8px", "blur": "24px", "spread": "-4px", "color": "#00000099" }] } }
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": "150ms" },
      "slow": { "$value": "320ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "out": { "$value": [0.2, 0.8, 0.2, 1] },
      "in-out": { "$value": [0.4, 0, 0.2, 1] }
    },
    "distance": {
      "$type": "dimension",
      "nudge": { "$value": "4px" }
    }
  }
}
