/* {{@header}} */
@import "tailwindcss";

/* The theme class goes on <html> (class strategy). Tokens switch by themselves, so components rarely need dark:. */
@custom-variant dark (&:where(.dark, .dark *));

/* Closed scales: Tailwind's default colours, radii, shadows, text sizes, fonts and easings do not exist here.
   Spacing stays Tailwind's multiplier from the spacing base token; the audit enforces the scale. */
@theme static {
  --color-*: initial;
  --radius-*: initial;
  --shadow-*: initial;
  --text-*: initial;
  --font-*: initial;
  --ease-*: initial;

  {{@vars}}
}

{{@if-md}}
/* Values that change from the md breakpoint (768px) up. */
@media (width >= 48rem) {
  :root {
    {{@vars-md}}
  }
}
{{@end}}

/* Dark scheme: only the tokens that have a dark value. */
.dark {
  {{@vars-dark}}
  color-scheme: dark;
}

/* Tabular figures: required on every number. */
@utility tnum { font-variant-numeric: tabular-nums lining-nums; }

/* Motion is an enhancement. If the user asked for less, give them none. Never override this block. */
@media (prefers-reduced-motion: reduce) {
  *, ::before, ::after {
    animation-duration: 0s !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0s !important;
    transition-delay: 0s !important;
    scroll-behavior: auto !important;
  }
}
